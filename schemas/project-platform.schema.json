            "required",
            "policy",
            "schedule",
            "retention_days",
            "restore_test_frequency"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "policy": {
              "enum": [
                "not_applicable",
                "coolify_scheduled",
                "database_native",
                "external",
                "combined",
                "pending"
              ]
            },
            "schedule": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 3
                },
                {
                  "type": "null"
                }
              ]
            },
            "retention_days": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "restore_test_frequency": {
              "enum": [
                "not_applicable",
                "monthly",
                "quarterly",
                "biannual",
                "annual",
                "pending"
