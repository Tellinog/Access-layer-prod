            "published_host_ports"
          ],
          "properties": {
            "container_ports_may_repeat_across_coolify_resources": {
              "const": true
            },
            "host_ports_forbidden_by_default": {
              "const": true
            },
            "published_host_ports": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "target_service",
                  "container_port",
                  "host_port",
                  "protocol",
                  "bind_address",
                  "reason",
                  "approved_by",
                  "firewall_scope",
                  "expires_at"
