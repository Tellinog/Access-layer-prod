            },
            "backward_compatible_window_required": {
              "const": true
            },
            "runbook": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "registry": {
          "type": "object",
          "required": [
            "status",
            "central_registry_id",
            "registration_id",
            "validation_required_in_ci",
            "last_verified_at"
