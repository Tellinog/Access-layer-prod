{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://access-layer.unguess-internal.net/schemas/oauth-client-registration.p0.schema.json",
  "title": "Access Layer OAuth vNext P0 controlled client registration",
  "type": "object",
  "required": ["client_id", "client_name", "client_type", "status", "grant_types", "redirect_uris", "token_endpoint_auth_method", "allowed_resources", "allowed_scopes", "owner", "credential_lifecycle", "created_at", "updated_at"],
  "properties": {
    "client_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"},
    "client_name": {"type": "string", "minLength": 1},
    "client_type": {"enum": ["confidential", "public"]},
    "status": {"enum": ["draft", "active", "disabled"]},
    "grant_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["authorization_code", "refresh_token"]}},
    "redirect_uris": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri", "pattern": "^(https://|http://localhost(?::[0-9]{1,5})?/)[^*#]*$"}},
    "token_endpoint_auth_method": {"enum": ["client_secret_basic", "none"]},
    "allowed_resources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri", "pattern": "^https://[^*#]+$"}},
    "allowed_scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}:[a-z][a-z0-9-]{1,62}:[a-z][a-z0-9-]{1,62}$"}},
    "owner": {"type": "object", "required": ["team"], "properties": {"team": {"type": "string", "minLength": 1}, "contact": {"type": ["string", "null"]}}, "additionalProperties": false},
    "credential_lifecycle": {"type": "object", "required": ["secret_present", "rotated_at", "expires_at"], "properties": {"secret_present": {"type": "boolean"}, "rotated_at": {"type": ["string", "null"], "format": "date-time"}, "expires_at": {"type": ["string", "null"], "format": "date-time"}}, "additionalProperties": false},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"client_type": {"const": "confidential"}}, "required": ["client_type"]}, "then": {"properties": {"token_endpoint_auth_method": {"const": "client_secret_basic"}, "credential_lifecycle": {"properties": {"secret_present": {"const": true}}}}}},
    {"if": {"properties": {"client_type": {"const": "public"}}, "required": ["client_type"]}, "then": {"properties": {"token_endpoint_auth_method": {"const": "none"}, "credential_lifecycle": {"properties": {"secret_present": {"const": false}}}}}}
  ],
  "additionalProperties": false
}
