                    "const": false
                  },
                  "preserve_existing_consumers": {
                    "const": true
                  },
                  "preserve_active_sessions": {
                    "const": true
                  },
                  "preserve_refresh_tokens": {
                    "const": true
                  },
                  "preserve_token_claims": {
                    "const": true
                  },
                  "preserve_endpoints_and_payloads": {
                    "const": true
                  },
                  "rollback_without_data_loss": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ai": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "ai": {
            "properties": {
              "profile": {
                "const": "no_ai"
              }
            }
          }
        }
      }
    }
  ]
}
