{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "profile": "unguess-garden-v1",
    "source": "WEBSITE _ Garden.pdf",
    "source_scope": "Core palette, navy-to-green gradient, button treatment and colour-usage rules.",
    "extension_policy": "Typography, spacing, radii, shadows and semantic status colours are template extensions pending formal design approval.",
    "accessibility_target": "WCAG 2.2 AA"
  },
  "colour": {
    "brand": {
      "navy": {
        "$type": "color",
        "$value": "#003A57",
        "$description": "Source-defined navy."
      },
      "deepNavy": {
        "$type": "color",
        "$value": "#001D2C",
        "$description": "Source-defined deeper CTA text/institutional tone."
      },
      "green": {
        "$type": "color",
        "$value": "#00B27F",
        "$description": "Source-defined primary green; surface/decorative use, never text."
      },
      "lightGreen": {
        "$type": "color",
        "$value": "#54C38A",
        "$description": "Source-defined supporting green."
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#333333"
      },
      "secondary": {
        "$type": "color",
        "$value": "#4B5F5F"
      },
      "muted": {
        "$type": "color",
        "$value": "#7A7A7A",
        "$description": "Do not use for small text on white without a contrast exception."
      },
      "onDark": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "onGreenCta": {
        "$type": "color",
        "$value": "#001D2C"
      },
      "link": {
        "$type": "color",
        "$value": "#003A57"
      }
    },
    "surface": {
      "canvas": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "subtle": {
        "$type": "color",
        "$value": "#F9FAFA"
      },
      "brand": {
        "$type": "color",
        "$value": "#00B27F"
      },
      "dark": {
        "$type": "color",
        "$value": "#003A57"
      },
      "deeper": {
        "$type": "color",
        "$value": "#001D2C"
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "#C9D4D4",
        "$description": "Template extension."
      },
      "strong": {
        "$type": "color",
        "$value": "#4B5F5F"
      },
      "focus": {
        "$type": "color",
        "$value": "#003A57"
      }
    },
    "status": {
      "info": {
        "$type": "color",
        "$value": "#003A57",
        "$description": "Template semantic extension."
      },
      "success": {
        "$type": "color",
        "$value": "#006B4F",
        "$description": "Template semantic extension; not part of source PDF."
      },
      "warning": {
        "$type": "color",
        "$value": "#704700",
        "$description": "Template semantic extension; not part of source PDF."
      },
      "danger": {
        "$type": "color",
        "$value": "#A12622",
        "$description": "Template semantic extension; not part of source PDF."
      },
      "infoSubtle": {
        "$type": "color",
        "$value": "#E8F2F5"
      },
      "successSubtle": {
        "$type": "color",
        "$value": "#E8F6F1"
      },
      "warningSubtle": {
        "$type": "color",
        "$value": "#FFF4D6"
      },
      "dangerSubtle": {
        "$type": "color",
        "$value": "#FDECEC"
      }
    }
  },
  "gradient": {
    "brand": {
      "$type": "gradient",
      "$value": [
        {
          "color": "#003A57",
          "position": 0
        },
        {
          "color": "#00B27F",
          "position": 1
        }
      ],
      "$description": "Source-defined navy-to-green gradient. White text is allowed only on the sufficiently dark/navy region."
    },
    "institutional": {
      "$type": "gradient",
      "$value": [
        {
          "color": "#001D2C",
          "position": 0
        },
        {
          "color": "#003A57",
          "position": 1
        }
      ],
      "$description": "Template extension using source-defined deep tones."
    }
  },
  "typography": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Inter",
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "BlinkMacSystemFont",
          "Segoe UI",
          "sans-serif"
        ],
        "$description": "No font file is distributed; falls back to system UI."
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Monaco",
          "Consolas",
          "monospace"
        ]
      }
    },
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": "0.75rem"
      },
      "sm": {
        "$type": "dimension",
        "$value": "0.875rem"
      },
      "md": {
        "$type": "dimension",
        "$value": "1rem"
      },
      "lg": {
        "$type": "dimension",
        "$value": "1.125rem"
      },
      "xl": {
        "$type": "dimension",
        "$value": "1.5rem"
      },
      "2xl": {
        "$type": "dimension",
        "$value": "2rem"
      },
      "3xl": {
        "$type": "dimension",
        "$value": "2.75rem"
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    },
    "lineHeight": {
      "tight": {
        "$type": "number",
        "$value": 1.2
      },
      "normal": {
        "$type": "number",
        "$value": 1.5
      },
      "relaxed": {
        "$type": "number",
        "$value": 1.7
      }
    }
  },
  "space": {
    "0": {
      "$type": "dimension",
      "$value": "0"
    },
    "1": {
      "$type": "dimension",
      "$value": "0.25rem"
    },
    "2": {
      "$type": "dimension",
      "$value": "0.5rem"
    },
    "3": {
      "$type": "dimension",
      "$value": "0.75rem"
    },
    "4": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "5": {
      "$type": "dimension",
      "$value": "1.25rem"
    },
    "6": {
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "8": {
      "$type": "dimension",
      "$value": "2rem"
    },
    "10": {
      "$type": "dimension",
      "$value": "2.5rem"
    },
    "12": {
      "$type": "dimension",
      "$value": "3rem"
    },
    "16": {
      "$type": "dimension",
      "$value": "4rem"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "0.375rem"
    },
    "md": {
      "$type": "dimension",
      "$value": "0.625rem"
    },
    "lg": {
      "$type": "dimension",
      "$value": "0.875rem"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "shadow": {
    "sm": {
      "$type": "shadow",
      "$value": {
        "color": "#001D2C1A",
        "offsetX": "0",
        "offsetY": "1px",
        "blur": "3px",
        "spread": "0"
      }
    },
    "md": {
      "$type": "shadow",
      "$value": {
        "color": "#001D2C1F",
        "offsetX": "0",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "-8px"
      }
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "120ms"
      },
      "standard": {
        "$type": "duration",
        "$value": "150ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      }
    },
    "hoverTranslateY": {
      "$type": "dimension",
      "$value": "-1px"
    }
  }
}
