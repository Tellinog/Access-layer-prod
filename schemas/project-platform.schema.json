                "properties": {
                  "target_service": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,62}$"
                  },
                  "container_port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "host_port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "protocol": {
                    "enum": [
                      "tcp",
                      "udp"
                    ]
                  },
                  "bind_address": {
                    "type": "string",
                    "minLength": 2
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 10
                  },
                  "approved_by": {
                    "type": "string",
                    "minLength": 2
                  },
                  "firewall_scope": {
                    "type": "string",
                    "minLength": 2
                  },
                  "expires_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "persistent_storage": {
          "type": "object",
          "required": [
            "required",
            "volumes"
          ],
          "properties": {
            "required": {
              "type": "boolean"
