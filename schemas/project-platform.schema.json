              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,62}:[a-z][a-z0-9-]{1,31}$"
            },
            "validation_required_in_ci": {
              "type": "boolean"
            },
            "last_verified_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "authentication": {
            "properties": {
