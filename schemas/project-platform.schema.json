                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "database": {
          "type": "object",
          "required": [
            "required",
            "service_name",
            "public_exposure",
            "backup_required"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "service_name": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,62}$"
