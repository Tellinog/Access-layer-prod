{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.unguess-internal.net/schemas/oauth-protected-resource-metadata.schema.json",
  "title": "OAuth protected-resource metadata",
  "type": "object",
  "required": [
    "resource",
    "authorization_servers",
    "scopes_supported",
    "bearer_methods_supported"
  ],
  "properties": {
    "resource": {
      "type": "string",
      "format": "uri"
    },
    "authorization_servers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "scopes_supported": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+(?::[a-z0-9-]+)+$"
      }
    },
    "bearer_methods_supported": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["header"]
      }
    },
    "resource_name": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
