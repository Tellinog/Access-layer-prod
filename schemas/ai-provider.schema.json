{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.unguess-internal.net/schemas/ai-provider.schema.json",
  "title": "Approved AI provider/model registry entry",
  "type": "object",
  "required": [
    "provider_id",
    "broker",
    "underlying_provider",
    "model_id",
    "model_version_policy",
    "status",
    "owner",
    "retention",
    "training_use",
    "data_region",
    "dpa",
    "subprocessors",
    "allowed_data_classes"
  ],
  "properties": {
    "provider_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "broker": {
      "type": [
        "string",
        "null"
      ]
    },
    "underlying_provider": {
      "type": "string",
      "minLength": 2
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "model_version_policy": {
      "enum": [
        "pinned",
        "versioned_alias_with_change_gate"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "suspended",
        "rejected"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "retention": {
      "type": "object",
      "required": [
        "status",
        "reviewed_at",
        "reviewed_by",
        "evidence_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "documented",
            "verified",
            "approved",
            "rejected",
            "not_applicable"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "reviewed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "training_use": {
      "type": "object",
      "required": [
        "status",
        "reviewed_at",
        "reviewed_by",
        "evidence_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "documented",
            "verified",
            "approved",
            "rejected",
            "not_applicable"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "reviewed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "data_region": {
      "type": "object",
      "required": [
        "status",
        "reviewed_at",
        "reviewed_by",
        "evidence_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "documented",
            "verified",
            "approved",
            "rejected",
            "not_applicable"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "reviewed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "dpa": {
      "type": "object",
      "required": [
        "status",
        "reviewed_at",
        "reviewed_by",
        "evidence_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "documented",
            "verified",
            "approved",
            "rejected",
            "not_applicable"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "reviewed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "subprocessors": {
      "type": "object",
      "required": [
        "status",
        "reviewed_at",
        "reviewed_by",
        "evidence_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "documented",
            "verified",
            "approved",
            "rejected",
            "not_applicable"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "reviewed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "allowed_data_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "public",
          "internal_approved",
          "confidential_approved",
          "personal_approved"
        ]
      }
    },
    "forbidden_data_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "credentials",
          "auth_tokens",
          "special_category_data",
          "ai_prohibited"
        ]
      }
    },
    "review_expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
