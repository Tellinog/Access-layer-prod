# Step 1 compatibility copy of the production environment contract.
# Keep this file synchronized with .env.production.example. Never add secrets.
APP_ENV=production
PUBLIC_BASE_PATH=
APP_BASE_URL=https://access-layer.unguess-internal.net
AUTH_ISSUER=https://access-layer.unguess-internal.net
PORT=8080
LOG_LEVEL=info
TRUST_PROXY_HOPS=1

POSTGRES_USER=access_layer
POSTGRES_PASSWORD=<long-random-password>
POSTGRES_DB=access_layer
DATABASE_URL=postgresql://access_layer:<same-password-url-encoded-if-needed>@postgres:5432/access_layer

GOOGLE_CLIENT_ID=<google-web-oauth-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<google-web-oauth-client-secret>
GOOGLE_REDIRECT_URI=https://access-layer.unguess-internal.net/v1/auth/google/callback
GOOGLE_ALLOWED_HD=unguess.io,nuotounostiledivita.it
GOOGLE_OIDC_SCOPE=openid email profile

# Temporary legacy-only Microsoft Entra bridge. Keep disabled unless explicitly authorised.
LEGACY_MICROSOFT_ENABLED=false
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://access-layer.unguess-internal.net/v1/auth/microsoft/callback
MICROSOFT_OIDC_SCOPE=openid profile email
MICROSOFT_ALLOWED_EMAIL_DOMAINS=testbirds.com,testbirds.de
LEGACY_MICROSOFT_TOOL_SLUGS=test-generator

JWT_PRIVATE_KEY_PEM_PATH=/run/secrets/access-layer-jwt-private.pem
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_ID=prod-key-1
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=28800
ONE_TIME_CODE_TTL_SECONDS=60
ENABLE_REFRESH_TOKENS=true
OAUTH_P0_ENABLED=false
# The transaction key is required only when OAUTH_P0_ENABLED=true.
# The credential pepper and signing root are also required, while OAuth remains
# disabled, for the corresponding OAuth Admin create/rotate/generate operations.
OAUTH_TRANSACTION_PROTECTION_KEY=
OAUTH_CREDENTIAL_SECRET_PEPPER=
OAUTH_SIGNING_KEY_ROOT=
SESSION_COOKIE_NAME=access_layer_admin_session
SESSION_SECRET=<long-random-secret>

TOOL_CLIENT_SECRET_PEPPER=<long-random-secret>
BACKUP_ENCRYPTION_KEY=<long-random-secret-min-32-chars>
CORS_ALLOWED_ORIGINS=https://access-layer.unguess-internal.net
RETURN_URL_ALLOWED_SCHEMES=https

ADMIN_BOOTSTRAP_EMAILS=lorenzo.prandi@unguess.io,lorenzo@nuotounostiledivita.it

LOG_IP_SALT=<long-random-secret>
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_RAW_IP=false
ACCESS_REQUEST_REOPEN_AFTER_DAYS=30

RUN_MIGRATIONS_ON_START=true
RUN_SEED_ON_START=true
SEED_EXAMPLE_TOOLS=false

SIEM_EXPORT_ENABLED=false
SIEM_EXPORT_ENDPOINT=
SIEM_EXPORT_TOKEN=
BACKUP_API_TOKEN=
