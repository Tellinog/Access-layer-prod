{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://access-layer.unguess-internal.net/schemas/oauth-authorization-server-metadata.p0.schema.json",
  "title": "Access Layer OAuth vNext P0 authorization-server metadata",
  "type": "object",
  "required": [
    "issuer",
    "authorization_endpoint",
    "token_endpoint",
    "jwks_uri",
    "revocation_endpoint",
    "introspection_endpoint",
    "response_types_supported",
    "grant_types_supported",
    "code_challenge_methods_supported",
    "token_endpoint_auth_methods_supported",
    "revocation_endpoint_auth_methods_supported",
    "introspection_endpoint_auth_methods_supported",
    "authorization_response_iss_parameter_supported"
  ],
  "properties": {
    "issuer": {"const": "https://access-layer.unguess-internal.net"},
    "authorization_endpoint": {"const": "https://access-layer.unguess-internal.net/oauth/authorize"},
    "token_endpoint": {"const": "https://access-layer.unguess-internal.net/oauth/token"},
    "jwks_uri": {"const": "https://access-layer.unguess-internal.net/oauth/jwks"},
    "revocation_endpoint": {"const": "https://access-layer.unguess-internal.net/oauth/revoke"},
    "introspection_endpoint": {"const": "https://access-layer.unguess-internal.net/oauth/introspect"},
    "response_types_supported": {"const": ["code"]},
    "grant_types_supported": {"const": ["authorization_code", "refresh_token"]},
    "code_challenge_methods_supported": {"const": ["S256"]},
    "token_endpoint_auth_methods_supported": {"const": ["client_secret_basic", "none"]},
    "revocation_endpoint_auth_methods_supported": {"const": ["client_secret_basic", "none"]},
    "introspection_endpoint_auth_methods_supported": {"const": ["client_secret_basic"]},
    "authorization_response_iss_parameter_supported": {"const": true}
  },
  "additionalProperties": false
}
