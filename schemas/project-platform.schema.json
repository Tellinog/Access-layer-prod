              "hostname",
              "scheme",
              "path",
              "target_service",
              "target_container_port",
              "canonical",
              "shared_hostname"
            ],
            "properties": {
              "route_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,62}$"
