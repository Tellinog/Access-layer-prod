{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://access-layer.unguess-internal.net/schemas/production-continuity-evidence.v2.schema.json",
  "title": "Access Layer production continuity evidence bundle v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "captured_at", "captured_by", "repository", "coolify", "domains", "runtime", "storage", "backup", "database", "jwt_signing_material", "secret_continuity", "configuration", "deployment_registry", "ownership", "approvals"],
  "properties": {
    "schema_version": {"const": 2},
    "status": {"enum": ["NOT_READY", "READY"]},
    "captured_at": {"$ref": "#/$defs/nullableDateTime"},
    "captured_by": {"$ref": "#/$defs/nullableNonEmptyString"},
    "repository": {
      "type": "object", "additionalProperties": false, "required": ["revision", "evidence_basis"],
      "properties": {
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "evidence_basis": {"type": "string", "minLength": 1}
      }
    },
    "coolify": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "server_name", "server_id", "project_name", "project_id", "environment_name", "environment_id", "resource_name", "resource_id", "destination_id", "resource_type", "repository", "branch", "auto_deploy_enabled", "preview_deployments_enabled", "compose_management", "predefined_network_enabled", "server_network"],
      "properties": {
        "version": {"$ref": "#/$defs/nullableNonEmptyString"},
        "server_name": {"$ref": "#/$defs/nullableNonEmptyString"},
        "server_id": {"$ref": "#/$defs/nullableNonEmptyString"}, "project_id": {"$ref": "#/$defs/nullableNonEmptyString"},
        "project_name": {"$ref": "#/$defs/nullableNonEmptyString"},
        "environment_name": {"$ref": "#/$defs/nullableNonEmptyString"},
        "environment_id": {"$ref": "#/$defs/nullableNonEmptyString"}, "resource_id": {"$ref": "#/$defs/nullableNonEmptyString"},
        "resource_name": {"$ref": "#/$defs/nullableNonEmptyString"},
        "destination_id": {"$ref": "#/$defs/nullableNonEmptyString"},
        "resource_type": {"type": ["string", "null"], "enum": ["application", "service", null]},
        "repository": {"$ref": "#/$defs/nullableNonEmptyString"},
        "branch": {"$ref": "#/$defs/nullableNonEmptyString"},
        "auto_deploy_enabled": {"type": ["boolean", "null"]},
        "preview_deployments_enabled": {"type": ["boolean", "null"]},
        "compose_management": {"type": ["string", "null"], "enum": ["coolify_managed", "raw", null]},
        "predefined_network_enabled": {"type": ["boolean", "null"]},
        "server_network": {"$ref": "#/$defs/nullableNonEmptyString"}
      }
    },
    "domains": {
      "type": "object", "additionalProperties": false,
      "required": ["live_current_origin", "live_current_origin_observed_from", "intended_target_origin"],
      "properties": {
        "live_current_origin": {"$ref": "#/$defs/nullableHttpsOrigin"},
        "live_current_origin_observed_from": {"$ref": "#/$defs/nullableNonEmptyString"},
        "intended_target_origin": {"$ref": "#/$defs/httpsOrigin"}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["deployed_revision", "image_reference", "image_digest", "replica_count", "deployment_strategy", "last_deployed_at", "observed_services", "repository_expectations"],
      "properties": {
        "deployed_revision": {"type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$"},
        "image_reference": {"$ref": "#/$defs/nullableNonEmptyString"},
        "image_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "replica_count": {"type": ["integer", "null"], "minimum": 1},
        "deployment_strategy": {"$ref": "#/$defs/nullableNonEmptyString"},
        "last_deployed_at": {"$ref": "#/$defs/nullableDateTime"},
        "observed_services": {
          "type": "object", "additionalProperties": false, "required": ["app", "postgres"],
          "properties": {"app": {"$ref": "#/$defs/observedService"}, "postgres": {"$ref": "#/$defs/observedService"}}
        },
        "repository_expectations": {
          "type": "object", "additionalProperties": false,
          "required": ["app_target_container_port", "postgres_target_container_port", "postgres_exposure", "public_host_port_mapping_expected"],
          "properties": {
            "app_target_container_port": {"const": 8080}, "postgres_target_container_port": {"const": 5432},
            "postgres_exposure": {"const": "private"}, "public_host_port_mapping_expected": {"const": false}
          }
        }
      }
    },
    "storage": {
      "type": "object", "additionalProperties": false,
      "required": ["postgres_container_mount_path", "compose_service_volume_reference", "compose_top_level_volume_declaration", "actual_storage_type", "actual_storage_identifier", "actual_host_or_destination_path", "mapping_observed_from", "mapping_verified", "verified_at", "verified_by", "evidence_reference"],
      "properties": {
        "postgres_container_mount_path": {"const": "/var/lib/postgresql/data"},
        "compose_service_volume_reference": {"const": "access_layer_postgres_data_v2"},
        "compose_top_level_volume_declaration": {"const": "access_layer_postgres_data_v2"},
        "actual_storage_type": {"$ref": "#/$defs/nullableStorageType"},
        "actual_storage_identifier": {"$ref": "#/$defs/nullableNonEmptyString"},
        "actual_host_or_destination_path": {"$ref": "#/$defs/nullableNonEmptyString"},
        "mapping_observed_from": {"$ref": "#/$defs/nullableNonEmptyString"},
        "mapping_verified": {"type": "boolean"}, "verified_at": {"$ref": "#/$defs/nullableDateTime"},
        "verified_by": {"$ref": "#/$defs/nullableNonEmptyString"}, "evidence_reference": {"$ref": "#/$defs/nullableNonEmptyString"}
      }
    },
    "backup": {
      "type": "object", "additionalProperties": false,
      "required": ["mechanism", "schedule", "retention", "storage_destination_class", "latest_verified_backup_id", "latest_verified_backup_at", "evidence_reference", "restore_test"],
      "properties": {
        "mechanism": {"$ref": "#/$defs/nullableNonEmptyString"}, "schedule": {"$ref": "#/$defs/nullableNonEmptyString"},
        "retention": {"$ref": "#/$defs/nullableNonEmptyString"}, "storage_destination_class": {"$ref": "#/$defs/nullableNonEmptyString"},
        "latest_verified_backup_id": {"$ref": "#/$defs/nullableNonEmptyString"}, "latest_verified_backup_at": {"$ref": "#/$defs/nullableDateTime"},
        "evidence_reference": {"$ref": "#/$defs/nullableNonEmptyString"},
        "restore_test": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "isolated_target", "target_identifier", "completed_at", "verified_by", "evidence_reference"],
          "properties": {
            "status": {"enum": ["NOT_RUN", "PASSED", "FAILED"]}, "isolated_target": {"type": ["boolean", "null"]},
            "target_identifier": {"$ref": "#/$defs/nullableNonEmptyString"}, "completed_at": {"$ref": "#/$defs/nullableDateTime"},
            "verified_by": {"$ref": "#/$defs/nullableNonEmptyString"}, "evidence_reference": {"$ref": "#/$defs/nullableNonEmptyString"}
          }
        }
      }
    },
    "database": {
      "type": "object", "additionalProperties": false,
      "required": ["metadata_collected", "collected_at", "server_version", "database_name", "schema_fingerprint_sha256", "migration_table", "applied_migration_ids", "metadata_source", "row_contents_collected"],
      "properties": {
        "metadata_collected": {"type": "boolean"}, "collected_at": {"$ref": "#/$defs/nullableDateTime"},
        "server_version": {"$ref": "#/$defs/nullableNonEmptyString"}, "database_name": {"$ref": "#/$defs/nullableNonEmptyString"},
        "schema_fingerprint_sha256": {"$ref": "#/$defs/nullableSha256Hex"}, "migration_table": {"const": "schema_migrations"},
        "applied_migration_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[^/\\\\]+\\.sql$"}},
        "metadata_source": {"$ref": "#/$defs/nullableNonEmptyString"}, "row_contents_collected": {"const": false}
      }
    },
    "jwt_signing_material": {
      "type": "object", "additionalProperties": false,
      "required": ["source_mode", "configured_file_path", "file_state", "public_key", "continuity_verification", "file_persistence"],
      "properties": {
        "source_mode": {"enum": ["unknown", "inline_env", "file_path"]},
        "configured_file_path": {"type": ["string", "null"], "pattern": "^/run/secrets/[^\\s]+$"},
        "file_state": {"$ref": "#/$defs/environmentState"},
        "public_key": {
          "type": "object", "additionalProperties": false, "required": ["jwks_observed_from", "kid", "fingerprint_sha256"],
          "properties": {
            "jwks_observed_from": {"$ref": "#/$defs/nullableNonEmptyString"}, "kid": {"$ref": "#/$defs/nullableNonEmptyString"},
            "fingerprint_sha256": {"$ref": "#/$defs/nullableSha256Hex"}
          }
        },
        "continuity_verification": {"$ref": "#/$defs/keyContinuityRecord"},
        "file_persistence": {
          "type": "object", "additionalProperties": false,
          "required": ["container_mount_path", "compose_volume_reference", "actual_storage_type", "actual_storage_identifier", "actual_host_or_destination_path", "mapping_observed_from", "mapping_verified", "verified_at", "verified_by", "evidence_reference"],
          "properties": {
            "container_mount_path": {"const": "/run/secrets"}, "compose_volume_reference": {"const": "access_layer_jwt_secrets"},
            "actual_storage_type": {"$ref": "#/$defs/nullableStorageType"}, "actual_storage_identifier": {"$ref": "#/$defs/nullableNonEmptyString"},
            "actual_host_or_destination_path": {"$ref": "#/$defs/nullableNonEmptyString"}, "mapping_observed_from": {"$ref": "#/$defs/nullableNonEmptyString"},
            "mapping_verified": {"type": "boolean"}, "verified_at": {"$ref": "#/$defs/nullableDateTime"},
            "verified_by": {"$ref": "#/$defs/nullableNonEmptyString"}, "evidence_reference": {"$ref": "#/$defs/nullableNonEmptyString"}
          }
        }
      }
    },
    "secret_continuity": {
      "type": "object", "additionalProperties": false,
      "required": ["secret_values_or_reusable_verifiers_committed", "records"],
      "properties": {
        "secret_values_or_reusable_verifiers_committed": {"const": false},
        "records": {
          "type": "object", "additionalProperties": false,
          "required": ["SESSION_SECRET", "TOOL_CLIENT_SECRET_PEPPER", "BACKUP_ENCRYPTION_KEY", "GOOGLE_CLIENT_SECRET", "LOG_IP_SALT"],
          "properties": {
            "SESSION_SECRET": {"$ref": "#/$defs/secretContinuityRecord"},
            "TOOL_CLIENT_SECRET_PEPPER": {"$ref": "#/$defs/secretContinuityRecord"},
            "BACKUP_ENCRYPTION_KEY": {"$ref": "#/$defs/secretContinuityRecord"},
            "GOOGLE_CLIENT_SECRET": {"$ref": "#/$defs/secretContinuityRecord"},
            "LOG_IP_SALT": {"$ref": "#/$defs/secretContinuityRecord"}
          }
        }
      }
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["source_inventory", "observation", "environment_state", "effective_non_secret_config"],
      "properties": {
        "source_inventory": {
          "type": "object", "additionalProperties": false, "required": ["derived_from", "variables"],
          "properties": {
            "derived_from": {"const": ["src/config.ts", "docker-compose.yaml", "docker/entrypoint.sh"]},
            "variables": {"const": ["ACCESS_REQUEST_REOPEN_AFTER_DAYS", "ACCESS_TOKEN_TTL_SECONDS", "ADMIN_BOOTSTRAP_EMAILS", "APP_BASE_URL", "APP_ENV", "AUDIT_LOG_RAW_IP", "AUDIT_LOG_RETENTION_DAYS", "AUTH_ISSUER", "BACKUP_API_TOKEN", "BACKUP_ENCRYPTION_KEY", "CORS_ALLOWED_ORIGINS", "DATABASE_URL", "ENABLE_REFRESH_TOKENS", "GOOGLE_ALLOWED_HD", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "GOOGLE_OIDC_SCOPE", "GOOGLE_REDIRECT_URI", "JWT_PRIVATE_KEY_PEM", "JWT_PRIVATE_KEY_PEM_PATH", "JWT_PUBLIC_KEY_ID", "LOG_IP_SALT", "LOG_LEVEL", "ONE_TIME_CODE_TTL_SECONDS", "PORT", "POSTGRES_DB", "POSTGRES_PASSWORD", "POSTGRES_USER", "PUBLIC_BASE_PATH", "REFRESH_TOKEN_TTL_SECONDS", "RETURN_URL_ALLOWED_SCHEMES", "RUN_MIGRATIONS_ON_START", "RUN_SEED_ON_START", "SEED_EXAMPLE_TOOLS", "SESSION_COOKIE_NAME", "SESSION_SECRET", "SIEM_EXPORT_ENABLED", "SIEM_EXPORT_ENDPOINT", "SIEM_EXPORT_TOKEN", "TOOL_CLIENT_SECRET_PEPPER", "TRUST_PROXY_HOPS"]}
          }
        },
        "observation": {
          "type": "object", "additionalProperties": false,
          "required": ["observed_at", "observed_by", "evidence_reference", "runtime_config_validation_observed"],
          "properties": {
            "observed_at": {"$ref": "#/$defs/nullableDateTime"}, "observed_by": {"$ref": "#/$defs/nullableNonEmptyString"},
            "evidence_reference": {"$ref": "#/$defs/nullableNonEmptyString"}, "runtime_config_validation_observed": {"type": "boolean"}
          }
        },
        "environment_state": {"$ref": "#/$defs/environmentStateMap"},
        "effective_non_secret_config": {"$ref": "#/$defs/effectiveConfig"}
      }
    },
    "deployment_registry": {
      "type": "object", "additionalProperties": false, "required": ["record_verified", "registry_identifier", "evidence_reference"],
      "properties": {
        "record_verified": {"type": "boolean"}, "registry_identifier": {"$ref": "#/$defs/nullableNonEmptyString"},
        "evidence_reference": {"$ref": "#/$defs/nullableNonEmptyString"}
      }
    },
    "ownership": {
      "type": "object", "additionalProperties": false, "required": ["owner_team", "technical_owner", "product_owner", "continuity_operator"],
      "properties": {
        "owner_team": {"$ref": "#/$defs/nullableNonEmptyString"}, "technical_owner": {"$ref": "#/$defs/nullableNonEmptyString"},
        "product_owner": {"$ref": "#/$defs/nullableNonEmptyString"}, "continuity_operator": {"$ref": "#/$defs/nullableNonEmptyString"}
      }
    },
    "approvals": {
      "type": "object", "additionalProperties": false,
      "required": ["live_topology_verified", "postgres_storage_mapping_verified", "backup_policy_verified", "jwt_signing_material_verified", "secret_continuity_verified", "configuration_verified", "ready_for_isolated_restore", "restore_test_verified", "ready_for_n_to_n_plus_1"],
      "properties": {
        "live_topology_verified": {"type": "boolean"}, "postgres_storage_mapping_verified": {"type": "boolean"},
        "backup_policy_verified": {"type": "boolean"}, "jwt_signing_material_verified": {"type": "boolean"},
        "secret_continuity_verified": {"type": "boolean"}, "configuration_verified": {"type": "boolean"},
        "ready_for_isolated_restore": {"type": "boolean"}, "restore_test_verified": {"type": "boolean"},
        "ready_for_n_to_n_plus_1": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "nullableNonEmptyString": {"type": ["string", "null"], "minLength": 1},
    "nullableDateTime": {"type": ["string", "null"], "format": "date-time"},
    "httpsOrigin": {"type": "string", "pattern": "^https://[^/?#]+$"},
    "nullableHttpsOrigin": {"type": ["string", "null"], "pattern": "^https://[^/?#]+$"},
    "nullableUri": {"type": ["string", "null"], "format": "uri"},
    "nullableSha256Hex": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "nullableStorageType": {"type": ["string", "null"], "enum": ["named_volume", "bind_mount", "managed_storage", "other", null]},
    "environmentState": {"enum": ["UNOBSERVED", "ABSENT", "PRESENT_EMPTY", "PRESENT_NON_EMPTY"]},
    "verificationMethod": {"type": ["string", "null"], "enum": ["secret_manager_version_reference", "operator_side_by_side_comparison", "controlled_injection_record", "public_key_comparison", "other_approved_method", null]},
    "secretContinuityRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["comparison_scope", "verified_same_value", "verification_method", "verified_by", "verified_at", "evidence_reference", "reusable_verifier_committed"],
      "properties": {
        "comparison_scope": {"const": "live_N_to_isolated_target"},
        "verified_same_value": {"type": "boolean"}, "verification_method": {"$ref": "#/$defs/verificationMethod"},
        "verified_by": {"$ref": "#/$defs/nullableNonEmptyString"}, "verified_at": {"$ref": "#/$defs/nullableDateTime"},
        "evidence_reference": {"$ref": "#/$defs/nullableNonEmptyString"}, "reusable_verifier_committed": {"const": false}
      }
    },
    "keyContinuityRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["comparison_scope", "verified_same_key", "verification_method", "verified_by", "verified_at", "evidence_reference", "reusable_private_verifier_committed"],
      "properties": {
        "comparison_scope": {"const": "live_N_to_isolated_target"},
        "verified_same_key": {"type": "boolean"}, "verification_method": {"$ref": "#/$defs/verificationMethod"},
        "verified_by": {"$ref": "#/$defs/nullableNonEmptyString"}, "verified_at": {"$ref": "#/$defs/nullableDateTime"},
        "evidence_reference": {"$ref": "#/$defs/nullableNonEmptyString"}, "reusable_private_verifier_committed": {"const": false}
      }
    },
    "observedService": {
      "type": "object", "additionalProperties": false,
      "required": ["service_name", "target_container_port", "public_host_port", "public_host_port_mapping_observed", "exposure"],
      "properties": {
        "service_name": {"$ref": "#/$defs/nullableNonEmptyString"},
        "target_container_port": {"type": ["integer", "null"], "minimum": 1, "maximum": 65535},
        "public_host_port": {"type": ["integer", "null"], "minimum": 1, "maximum": 65535},
        "public_host_port_mapping_observed": {"type": "boolean"},
        "exposure": {"type": ["string", "null"], "enum": ["public_via_proxy", "private", null]}
      }
    },
    "environmentStateMap": {
      "type": "object", "additionalProperties": false,
      "required": ["ACCESS_REQUEST_REOPEN_AFTER_DAYS", "ACCESS_TOKEN_TTL_SECONDS", "ADMIN_BOOTSTRAP_EMAILS", "APP_BASE_URL", "APP_ENV", "AUDIT_LOG_RAW_IP", "AUDIT_LOG_RETENTION_DAYS", "AUTH_ISSUER", "BACKUP_API_TOKEN", "BACKUP_ENCRYPTION_KEY", "CORS_ALLOWED_ORIGINS", "DATABASE_URL", "ENABLE_REFRESH_TOKENS", "GOOGLE_ALLOWED_HD", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "GOOGLE_OIDC_SCOPE", "GOOGLE_REDIRECT_URI", "JWT_PRIVATE_KEY_PEM", "JWT_PRIVATE_KEY_PEM_PATH", "JWT_PUBLIC_KEY_ID", "LOG_IP_SALT", "LOG_LEVEL", "ONE_TIME_CODE_TTL_SECONDS", "PORT", "POSTGRES_DB", "POSTGRES_PASSWORD", "POSTGRES_USER", "PUBLIC_BASE_PATH", "REFRESH_TOKEN_TTL_SECONDS", "RETURN_URL_ALLOWED_SCHEMES", "RUN_MIGRATIONS_ON_START", "RUN_SEED_ON_START", "SEED_EXAMPLE_TOOLS", "SESSION_COOKIE_NAME", "SESSION_SECRET", "SIEM_EXPORT_ENABLED", "SIEM_EXPORT_ENDPOINT", "SIEM_EXPORT_TOKEN", "TOOL_CLIENT_SECRET_PEPPER", "TRUST_PROXY_HOPS"],
      "properties": {
        "ACCESS_REQUEST_REOPEN_AFTER_DAYS": {"$ref": "#/$defs/environmentState"}, "ACCESS_TOKEN_TTL_SECONDS": {"$ref": "#/$defs/environmentState"},
        "ADMIN_BOOTSTRAP_EMAILS": {"$ref": "#/$defs/environmentState"}, "APP_BASE_URL": {"$ref": "#/$defs/environmentState"},
        "APP_ENV": {"$ref": "#/$defs/environmentState"}, "AUDIT_LOG_RAW_IP": {"$ref": "#/$defs/environmentState"},
        "AUDIT_LOG_RETENTION_DAYS": {"$ref": "#/$defs/environmentState"}, "AUTH_ISSUER": {"$ref": "#/$defs/environmentState"},
        "BACKUP_API_TOKEN": {"$ref": "#/$defs/environmentState"}, "BACKUP_ENCRYPTION_KEY": {"$ref": "#/$defs/environmentState"},
        "CORS_ALLOWED_ORIGINS": {"$ref": "#/$defs/environmentState"}, "DATABASE_URL": {"$ref": "#/$defs/environmentState"},
        "ENABLE_REFRESH_TOKENS": {"$ref": "#/$defs/environmentState"}, "GOOGLE_ALLOWED_HD": {"$ref": "#/$defs/environmentState"},
        "GOOGLE_CLIENT_ID": {"$ref": "#/$defs/environmentState"}, "GOOGLE_CLIENT_SECRET": {"$ref": "#/$defs/environmentState"},
        "GOOGLE_OIDC_SCOPE": {"$ref": "#/$defs/environmentState"}, "GOOGLE_REDIRECT_URI": {"$ref": "#/$defs/environmentState"},
        "JWT_PRIVATE_KEY_PEM": {"$ref": "#/$defs/environmentState"}, "JWT_PRIVATE_KEY_PEM_PATH": {"$ref": "#/$defs/environmentState"},
        "JWT_PUBLIC_KEY_ID": {"$ref": "#/$defs/environmentState"}, "LOG_IP_SALT": {"$ref": "#/$defs/environmentState"},
        "LOG_LEVEL": {"$ref": "#/$defs/environmentState"}, "ONE_TIME_CODE_TTL_SECONDS": {"$ref": "#/$defs/environmentState"},
        "PORT": {"$ref": "#/$defs/environmentState"}, "POSTGRES_DB": {"$ref": "#/$defs/environmentState"},
        "POSTGRES_PASSWORD": {"$ref": "#/$defs/environmentState"}, "POSTGRES_USER": {"$ref": "#/$defs/environmentState"},
        "PUBLIC_BASE_PATH": {"$ref": "#/$defs/environmentState"}, "REFRESH_TOKEN_TTL_SECONDS": {"$ref": "#/$defs/environmentState"},
        "RETURN_URL_ALLOWED_SCHEMES": {"$ref": "#/$defs/environmentState"}, "RUN_MIGRATIONS_ON_START": {"$ref": "#/$defs/environmentState"},
        "RUN_SEED_ON_START": {"$ref": "#/$defs/environmentState"}, "SEED_EXAMPLE_TOOLS": {"$ref": "#/$defs/environmentState"},
        "SESSION_COOKIE_NAME": {"$ref": "#/$defs/environmentState"}, "SESSION_SECRET": {"$ref": "#/$defs/environmentState"},
        "SIEM_EXPORT_ENABLED": {"$ref": "#/$defs/environmentState"}, "SIEM_EXPORT_ENDPOINT": {"$ref": "#/$defs/environmentState"},
        "SIEM_EXPORT_TOKEN": {"$ref": "#/$defs/environmentState"}, "TOOL_CLIENT_SECRET_PEPPER": {"$ref": "#/$defs/environmentState"},
        "TRUST_PROXY_HOPS": {"$ref": "#/$defs/environmentState"}
      }
    },
    "effectiveConfig": {
      "type": "object", "additionalProperties": false,
      "required": ["app_env", "public_base_path", "app_base_url", "auth_issuer", "port", "log_level", "postgres_user", "postgres_database", "google_client_id", "google_redirect_uri", "google_allowed_hd", "google_oidc_scope", "jwt_public_key_id", "access_token_ttl_seconds", "refresh_token_ttl_seconds", "one_time_code_ttl_seconds", "enable_refresh_tokens", "session_cookie_name", "cors_allowed_origins", "return_url_allowed_schemes", "trust_proxy_hops", "audit_log_retention_days", "audit_log_raw_ip", "access_request_reopen_after_days", "run_migrations_on_start", "run_seed_on_start", "seed_example_tools", "siem_export_enabled", "siem_export_endpoint", "admin_bootstrap_email_count"],
      "properties": {
        "app_env": {"type": ["string", "null"], "enum": ["development", "staging", "production", "test", null]},
        "public_base_path": {"type": ["string", "null"], "pattern": "^(|/[^?#\\\\]*)$"},
        "app_base_url": {"$ref": "#/$defs/nullableUri"}, "auth_issuer": {"$ref": "#/$defs/nullableUri"},
        "port": {"type": ["integer", "null"], "minimum": 1, "maximum": 65535}, "log_level": {"$ref": "#/$defs/nullableNonEmptyString"},
        "postgres_user": {"$ref": "#/$defs/nullableNonEmptyString"}, "postgres_database": {"$ref": "#/$defs/nullableNonEmptyString"},
        "google_client_id": {"$ref": "#/$defs/nullableNonEmptyString"}, "google_redirect_uri": {"$ref": "#/$defs/nullableUri"},
        "google_allowed_hd": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9.-]+$"}},
        "google_oidc_scope": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "jwt_public_key_id": {"$ref": "#/$defs/nullableNonEmptyString"},
        "access_token_ttl_seconds": {"type": ["integer", "null"], "minimum": 60, "maximum": 3600},
        "refresh_token_ttl_seconds": {"type": ["integer", "null"], "minimum": 300, "maximum": 86400},
        "one_time_code_ttl_seconds": {"type": ["integer", "null"], "minimum": 15, "maximum": 300},
        "enable_refresh_tokens": {"type": ["boolean", "null"]}, "session_cookie_name": {"$ref": "#/$defs/nullableNonEmptyString"},
