{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.unguess-internal.net/schemas/oauth-access-token-claims.schema.json",
  "title": "Access Layer OAuth vNext P0 RFC 9068 human access-token claims",
  "x-unguess-subject-source": "user.google_sub",
  "x-unguess-pii-minimised": true,
  "type": "object",
  "required": [
    "iss",
    "sub",
    "aud",
    "client_id",
    "scope",
    "iat",
    "exp",
    "jti",
    "principal_type"
  ],
  "properties": {
    "iss": {
      "type": "string",
      "format": "uri"
    },
    "sub": {
      "type": "string",
      "minLength": 1,
      "description": "Stable Google sub for the human, preserving D-004; never email or the local user UUID."
    },
    "aud": {
      "type": "string",
      "format": "uri"
    },
    "client_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}:[a-z][a-z0-9-]{1,62}:[a-z][a-z0-9-]{1,62}(?: [a-z][a-z0-9-]{1,62}:[a-z][a-z0-9-]{1,62}:[a-z][a-z0-9-]{1,62})*$"
    },
    "iat": {
      "type": "integer",
      "minimum": 0
    },
    "nbf": {
      "type": "integer",
      "minimum": 0
    },
    "exp": {
      "type": "integer",
      "minimum": 1
    },
    "jti": {
      "type": "string",
      "minLength": 8
    },
    "sid": {
      "type": "string"
    },
    "principal_type": {
      "const": "human"
    }
  },
  "additionalProperties": false
}
